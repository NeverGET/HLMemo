# Interpolation/orchestration ONLY. Copy to /etc/hlmemo/prod.env, chmod 600.
# Keep app.env, api.env, db.env and backup.env alongside it (examples in deploy/).
# Scripts resolve those sibling paths; raw Compose needs explicit HLM_*_ENV_FILE paths.
HLM_COMPOSE_PROJECT=hlmemo-prod
HLM_IMAGE=hlmemo:prod
HLM_DB_IMAGE=pgvector/pgvector:0.8.6-pg17
HLM_CADDY_IMAGE=caddy:2.11.2-alpine
HLM_DOMAIN=memory.example.invalid
HLM_TLS_MODE=acme

# Local isolation only (internal CA, never use for public production TLS):
# HLM_DOMAIN=localhost
# HLM_TLS_MODE=internal
# HLM_IMAGE=hlmemo:bake-astra
# BAKE_PROJECT=bake-astra
# BAKE_HTTP_PORT=18080
# BAKE_HTTPS_PORT=18443
# BAKE_BIND_IP=127.0.0.1
