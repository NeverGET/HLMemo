# TEMPLATE ONLY. Copy outside Git (production: /etc/hlmemo/prod.env), chmod 600.
# Set HLM_ENV_FILE to that absolute path AND pass --env-file when using raw Compose.
# Scripts handle both. Use simple KEY=value syntax; do not source this as shell code.
# Placeholder credentials only make G-D1 config validation possible; replace all CHANGE_ME.
HLM_COMPOSE_PROJECT=hlmemo-prod
HLM_IMAGE=hlmemo:prod
HLM_DB_IMAGE=pgvector/pgvector:0.8.6-pg17
HLM_CADDY_IMAGE=caddy:2.11.2-alpine
HLM_DOMAIN=memory.example.invalid
# acme for public HTTPS; internal ONLY for local CA testing (HLM_DOMAIN=localhost).
HLM_TLS_MODE=acme

POSTGRES_USER=hlm
POSTGRES_DB=hlm
# Generate hex with openssl rand -hex 32; copy the SAME password into HLM_DB_DSN.
POSTGRES_PASSWORD=CHANGE_ME_DATABASE
HLM_DB_DSN=postgresql://hlm:CHANGE_ME_DATABASE@db:5432/hlm
# Independent random values (openssl rand -hex 32). Admin binds device 1 at each API start.
HLM_ADMIN_TOKEN=CHANGE_ME_ADMIN
HLM_REGISTRATION_SECRET=CHANGE_ME_REGISTRATION
# Persist this across restarts for non-admin pagination cursors.
HLM_CURSOR_SECRET=CHANGE_ME_CURSOR
HLM_POOL_MIN_SIZE=1
HLM_POOL_MAX_SIZE=8
HLM_HOSTING_TARGET=compose
# API is unpublished on controlled private networks; only trusted containers may contact it.
# Caddy strips spoofed forwarded headers; this enables real client IP registration limits.
FORWARDED_ALLOW_IPS=*

# Optional provider settings; Phase 0 parses profiles but makes no librarian calls.
# Provider/model defaults remain in profiles/*.toml (D-017).
HLM_PROFILE=openrouter
# HLM_FALLBACK_PROFILE=openai
# HLM_LLM_BASE_URL=
# HLM_LLM_MODEL=
# HLM_LLM_API_KEY=
# HLM_LLM_REASONING={"enabled":false}
# HLM_EMBED_MODEL / HLM_EMBED_REVISION are application settings, but this Phase 0
# Dockerfile bakes the model pinned in models.lock. Changing an env var alone does NOT
# replace the baked assets; model changes require upstream support and a validated image.

# Local isolation only: export these in shell or place in your private local env file.
# BAKE_PROJECT=bake-astra
# BAKE_HTTP_PORT=18080
# BAKE_HTTPS_PORT=18443
# BAKE_BIND_IP=127.0.0.1

# Backup output; default deploy/backup/data for local runs; server uses /var/backups/hlmemo.
# HLM_BACKUP_DIR=/var/backups/hlmemo
# Optional upload: S3_BUCKET enables it. For S3-compatible storage configure ENDPOINT
# and AWS credentials below; standard AWS may use the normal credential chain.
S3_BUCKET=
S3_PREFIX=hlmemo
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
# AWS_SESSION_TOKEN=   # optional temporary credentials
# Use object-store lifecycle/versioning separately; local retention is 7 daily + 4 weekly.
