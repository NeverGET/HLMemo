# Librarian LLM configuration (W2a/R2). Lives next to prod.env/app.env (/etc/hlmemo/llm.env;
# HLM_LLM_ENV_FILE overrides), 0600, deploy user. OPTIONAL: without it the librarian idles.
# R2: `deploy/scripts/install_llm_env.sh --state DIR` writes it from this template (enabled,
# observer, the D-094 profiles below) and sends the key over ssh stdin. Mounted into the librarian
# AND the api (memory.risk_check judge, librarian job enqueue), never into db/worker/migrate/caddy.
# Provider, model ids and prices live in profiles/*.toml (D-017); this file selects them and holds
# the key. Never commit llm.env. RUNBOOK "R2 release (librarian ON, observer)".

# false: the librarian only writes a heartbeat (no job, no provider call, no key needed) and the
# api neither enqueues librarian jobs nor calls the risk judge (retrieval-only risk_check).
# Quick off switch: set false here, then `stack.sh up -d --no-deps librarian api` (RUNBOOK).
HLM_LIBRARIAN_ENABLED=false
# observer (default) | assistant | autonomous. A role above observer needs a matching owner
# decision event (hlm.ops librarian role ...), else the service refuses to start (§4b).
HLM_LIBRARIAN_ROLE=observer
# Jobs the librarian processes at the same time (default 3; 1 = one after the other, the R2
# behaviour). Each job keeps its own lease, privacy prechecks and fenced commit; the spend guard
# and the per-lineage call ceiling are atomic in the database, so they hold across jobs.
HLM_LIBRARIAN_CONCURRENCY=3
# Every database connection of the librarian process (job connections, lease renewer, loop, ledger
# pool). It needs 2 x HLM_LIBRARIAN_CONCURRENCY + 2; the librarian refuses to start otherwise.
HLM_LIBRARIAN_DB_CONNECTIONS=8
# Privacy is default-deny and not configurable: device:*-scoped items, projects with
# policy.librarian=off and items the triggering device cannot currently read never reach a provider.

# D-094 (owner-accepted D-093, bench/results/20260924-fallback-v2.md): the primary plus a fallback
# per task class. HLM_FALLBACK_PROFILE is every task's fallback; HLM_FALLBACK_PROFILE__<TASK> (task
# name upper-cased) replaces it for one task; a fallback whose profile lists the task in
# disabled_tasks is never used for it. Model ids and prices live only in profiles/*.toml (D-017).
# An unknown profile stops the api and the librarian at startup; `hlmemo.ops status` shows the
# effective primary and fallback per task.
HLM_PROFILE=openrouter-gpt6-luna
# Async librarian jobs: 92.4 on bench v2 vs 89.9 for the previous fallback (openrouter) and ~30%
# cheaper per correct answer; its slower p95 (22 s) is fine off the request path.
HLM_FALLBACK_PROFILE=openrouter-glm53-flash
# Synthesis (6 s cap): the only fallback fast enough for the deadline (p95 5.8 s).
HLM_FALLBACK_PROFILE__SYNTHESIS=openrouter
# Query rewrite (deadline-capped): same reason. Until the query_rewrite task ships, a startup
# warning says that no task of that name exists.
HLM_FALLBACK_PROFILE__QUERY_REWRITE=openrouter
# memory.risk_check judge (4 s cap): the reasoning-off profile that passes G-LIVE-C (catch 1.000,
# false-warn max 0.050 over 4 reps); it replaces D-071's retrieval-only fallback. Id-guarded judge
# only (bench v2 T11: complied with 3/29 injections): never a general librarian fallback.
HLM_FALLBACK_PROFILE__RISK_JUDGE=openrouter-qwen38-27b-fast
OPENROUTER_API_KEY=

# D-111/D-116: the release this llm.env belongs to (the RELEASE MANIFEST of check_librarian.py). R3
# ships WITHOUT the query rewrite and the per-source cap (D-116): HLM_QUERY_REWRITE and
# HLM_RETRIEVAL_SOURCE_CAP stay absent (or false), and the D-094 mapping above must be present. An
# llm.env without this marker is the R2 env of the D-108 interim (R3 image, R2 env).
HLM_ENV_RELEASE=r3
# live | record | replay | off (record/replay are for CI cassettes, see CC-5).
HLM_LLM_MODE=live
HLM_LLM_TIMEOUT_S=60

# Runaway guard, not a budget (D-058): atomic worst-case reservation per window (USD).
# A profile without prices refuses live calls unless HLM_LLM_BUDGET_DISABLED=true.
HLM_LLM_BUDGET_HOUR_USD=3
HLM_LLM_BUDGET_DAY_USD=10
HLM_LLM_BUDGET_MONTH_USD=60
HLM_LLM_JOB_CALL_CAP=20
HLM_LLM_BUDGET_DISABLED=false

# Optional extra redaction (the secret rule set is always on).
HLM_LLM_REDACT_EMAIL=false
HLM_LLM_REDACT_PHONE=false
