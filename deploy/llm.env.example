# Librarian LLM configuration (W2a). Copy to llm.env next to prod.env/app.env (e.g.
# /etc/hlmemo/llm.env; HLM_LLM_ENV_FILE overrides), chmod 600. OPTIONAL: R1 ships without it.
# Mounted into the librarian service only. Provider, model ids and prices live in profiles/*.toml
# (D-017); this file selects them and holds the key. Never commit llm.env. RUNBOOK "Librarian (W2a)".

# Off until R2. In R1 compose.prod.yaml pins HLM_LIBRARIAN_ENABLED=false (it wins over this file);
# disabled, the service only writes a heartbeat: no job, no provider call, no key needed.
# The R2 release removes the pin; then set this to true.
HLM_LIBRARIAN_ENABLED=false
# observer (default) | assistant | autonomous. A role above observer needs a matching owner
# decision event (hlm.ops librarian role ...), else the service refuses to start (§4b).
HLM_LIBRARIAN_ROLE=observer
# Privacy is default-deny and not configurable: device:*-scoped items, projects with
# policy.librarian=off and items the triggering device cannot currently read never reach a provider.

# D-066 (bench v2): default openai/gpt-6-luna, fallback deepseek/deepseek-v4.1-flash (different provider).
# Superseded D-019 profiles (openrouter = deepseek default, openrouter-luna = gpt-5.6-luna) remain available.
HLM_PROFILE=openrouter-gpt6-luna
HLM_FALLBACK_PROFILE=openrouter
OPENROUTER_API_KEY=
# live | record | replay | off (record/replay are for CI cassettes, see CC-5).
HLM_LLM_MODE=live
HLM_LLM_TIMEOUT_S=60

# Runaway guard, not a budget (D-058): atomic worst-case reservation per window (USD).
# A profile without prices refuses live calls unless HLM_LLM_BUDGET_DISABLED=true.
HLM_LLM_BUDGET_HOUR_USD=3
HLM_LLM_BUDGET_DAY_USD=10
HLM_LLM_BUDGET_MONTH_USD=60
HLM_LLM_JOB_CALL_CAP=20
HLM_LLM_BUDGET_DISABLED=false

# Optional extra redaction (the secret rule set is always on).
HLM_LLM_REDACT_EMAIL=false
HLM_LLM_REDACT_PHONE=false
