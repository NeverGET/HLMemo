# Host backup/upload ONLY; never injected into any container. Copy to backup.env, chmod 600.
HLM_BACKUP_DIR=/var/backups/hlmemo
# Successful deploys prune this tier; --prune-pre-upgrade also runs it explicitly.
HLM_PRE_UPGRADE_KEEP=5
S3_BUCKET=
S3_PREFIX=hlmemo
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-central-1
# AWS_SESSION_TOKEN=
# Bucket lifecycle/versioning is independent of local 7 daily + 4 weekly retention.
# Optional rclone copy (e.g. an encrypted crypt remote over Google Drive; RUNBOOK "Offsite copy").
# The config file holds the remote's token and must be writable by the backup user (token refresh).
RCLONE_REMOTE=
RCLONE_CONFIG=/etc/hlmemo/rclone.conf
RCLONE_KEEP_DAYS=14
RCLONE_KEEP_WEEKLY_DAYS=70
