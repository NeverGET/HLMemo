[Unit]
Description=HLMemo consistent daily PostgreSQL backup
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=hlmdeploy
Group=hlmdeploy
WorkingDirectory=/opt/hlmemo/app
Environment=HLM_ENV_FILE=/etc/hlmemo/prod.env
Environment=HLM_COMPOSE_PROJECT=hlmemo-prod
ExecStart=/opt/hlmemo/app/deploy/backup/backup.sh
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7

[Install]
WantedBy=multi-user.target
