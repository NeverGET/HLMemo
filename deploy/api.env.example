# API ONLY. Copy to api.env, chmod 600; generate an independent openssl rand -hex 32 value.
# W0a (D-061): no HLM_ADMIN_TOKEN and no HLM_REGISTRATION_SECRET. Public registration and admin
# HTTP are closed in compose.prod.yaml; devices are minted over SSH with deploy/scripts/hlm_ops.sh.
# Persist across API restarts for pagination cursors.
HLM_CURSOR_SECRET=CHANGE_ME_CURSOR
# Match the pinned frontend network; only trusted Caddy may reach the unpublished API.
HLM_TRUSTED_PROXY_IPS=172.30.39.0/24
