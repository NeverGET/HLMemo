# API ONLY. Copy to api.env, chmod 600; generate independent openssl rand -hex 32 values.
HLM_ADMIN_TOKEN=CHANGE_ME_ADMIN
HLM_REGISTRATION_SECRET=CHANGE_ME_REGISTRATION
# Persist across API restarts for pagination cursors.
HLM_CURSOR_SECRET=CHANGE_ME_CURSOR
# Only trusted Caddy may reach the unpublished API; Caddy strips spoofed headers.
FORWARDED_ALLOW_IPS=*
