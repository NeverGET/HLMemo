{
	admin localhost:2019
}

(tls_acme) {
	tls {
		issuer acme
	}
}

(tls_internal) {
	tls internal
}

{$HLM_DOMAIN} {
	import tls_{$HLM_TLS_MODE:acme}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Content-Security-Policy "default-src 'none'; frame-ancestors 'none'"
		-Server
	}

	@mcp path /mcp
	handle @mcp {
		request_body {
			max_size 64MiB
		}
		reverse_proxy api-frontend:8765 {
			flush_interval -1
		}
	}
	@rest path /health /ready /devices/* /admin/*
	handle @rest {
		request_body {
			max_size 64KiB
		}
		reverse_proxy api-frontend:8765
	}
	handle {
		respond "Not found" 404
	}
}

# Unpublished loopback route proves Caddy -> API independently of DNS and ACME.
http://127.0.0.1:8081 {
	bind 127.0.0.1
	handle /ready {
		reverse_proxy api-frontend:8765
	}
	handle {
		respond "Not found" 404
	}
}
