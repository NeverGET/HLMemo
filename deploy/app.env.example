# Shared API/worker/migration configuration. Copy to app.env, chmod 600.
# Match db.env POSTGRES_PASSWORD; hex passwords avoid DSN escaping pitfalls.
HLM_DB_DSN=postgresql://hlm:CHANGE_ME_DATABASE@db:5432/hlm
HLM_POOL_MIN_SIZE=1
HLM_POOL_MAX_SIZE=8
HLM_HOSTING_TARGET=compose
# Provider/model defaults remain in profiles/*.toml (D-017).
HLM_PROFILE=openrouter
# HLM_FALLBACK_PROFILE=openai
# HLM_LLM_BASE_URL=
# HLM_LLM_MODEL=
# HLM_LLM_API_KEY=
# HLM_LLM_REASONING={"enabled":false}
# Model assets are baked from models.lock; an env change cannot replace baked assets.
