{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "al-e4/v1 lesson synthesis from recurring mistake episodes (D-222 lesson schema)",
  "type": "object",
  "required": ["abstain", "abstain_reason", "lesson"],
  "properties": {
    "abstain": {"type": "boolean"},
    "abstain_reason": {"type": "string"},
    "lesson": {"anyOf": [{"type": "null"}, {"$ref": "#/$defs/lesson"}]}
  },
  "if": {"properties": {"abstain": {"const": true}}},
  "then": {"properties": {"lesson": {"type": "null"}}},
  "else": {"properties": {"lesson": {"$ref": "#/$defs/lesson"}}},
  "$defs": {
    "quote": {
      "type": "object",
      "required": ["source", "quote"],
      "properties": {"source": {"type": "string"}, "quote": {"type": "string"}}
    },
    "claim": {
      "type": "object",
      "required": ["text", "evidence"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "evidence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/quote"}}
      }
    },
    "lesson": {
      "type": "object",
      "required": [
        "title", "when", "do", "avoid", "not_verified_for", "scope",
        "recurrence_count", "group_count", "first_seen", "last_seen"
      ],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "when": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "do": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "avoid": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/claim"}},
        "not_verified_for": {"type": "array", "items": {"type": "string"}},
        "scope": {
          "type": "object",
          "required": ["stack", "versions"],
          "properties": {
            "stack": {"type": "array", "items": {"type": "string"}},
            "versions": {
              "type": "array",
              "items": {
                "type": "object",
                "required": ["component", "version"],
                "properties": {"component": {"type": "string"}, "version": {"type": "string"}}
              }
            }
          }
        },
        "recurrence_count": {"type": "integer", "minimum": 1},
        "group_count": {"type": "integer", "minimum": 1},
        "first_seen": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "last_seen": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}
      }
    }
  }
}
